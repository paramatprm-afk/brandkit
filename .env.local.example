# Copy this file to .env.local and fill in your keys.

# Get an API key from https://console.anthropic.com/settings/keys
# Read server-side only (app/api/generate/route.ts) to generate the brand kit text content.
ANTHROPIC_API_KEY=

# Get an API key from https://platform.openai.com/api-keys
# Read server-side only (app/api/logo/route.ts, model: gpt-image-1) to generate logo images.
OPENAI_API_KEY=

# From your Supabase project: Settings > API. The anon key is safe to expose to the
# browser (it's constrained by Row Level Security — see supabase/schema.sql) and is
# used for auth (email magic link) and reading/writing the current user's own brands.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# From the same project's Settings > API. NEVER exposed to the browser — read only by
# app/api/stripe/webhook/route.ts, which uses it to bypass Row Level Security and write
# the current user's plan after Stripe confirms it. Keep this out of client code.
SUPABASE_SERVICE_ROLE_KEY=

# From your Stripe dashboard (https://dashboard.stripe.com/apikeys). Read server-side
# only. STRIPE_PRICE_ID is the recurring monthly Price ID for the Pro plan (Product
# catalog > your product > pricing). STRIPE_WEBHOOK_SECRET comes from the endpoint you
# create at Developers > Webhooks pointing to <your-app-url>/api/stripe/webhook,
# subscribed to: checkout.session.completed, customer.subscription.updated,
# customer.subscription.deleted. For local testing, `stripe listen --forward-to
# localhost:3000/api/stripe/webhook` prints a temporary webhook secret to use here.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
