# Copy this file to .env.local and fill in your keys.
# Both keys are read server-side only and are never exposed to the browser.

# Get an API key from https://console.anthropic.com/settings/keys
# Used by app/api/generate/route.ts to generate the brand kit text content.
ANTHROPIC_API_KEY=

# Get an API key from https://platform.openai.com/api-keys
# Used by app/api/logo/route.ts (model: gpt-image-1) to generate logo images.
OPENAI_API_KEY=
